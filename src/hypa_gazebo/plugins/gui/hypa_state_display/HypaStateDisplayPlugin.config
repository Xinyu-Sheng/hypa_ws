<!-- 该文件是 Gazebo GUI 插件的配置文件 -->
<plugin>
  <!-- 插件库名称（不含 lib 前缀和 .so 后缀） -->
  <library>HypaStateDisplayPlugin</library>
  
  <!-- 插件在 Gazebo 中的显示标题 -->
  <name>HYPA State Display</name>
  
  <!-- 插件描述 -->
  <description>HYPA 机器人实时状态显示插件，包括关节状态、IMU 数据和日志面板</description>
  
  <!-- QML 主文件 URI -->
  <filename>qrc:/HypaStateDisplayPlugin/HypaStateDisplayPlugin.qml</filename>

  <!-- 默认话题配置 -->
  <imu_topic>/hypa/imu</imu_topic>
  <joint_state_topic>/hypa/joint_states</joint_state_topic>
  <log_topic>/hypa/log_stream</log_topic>
</plugin>
