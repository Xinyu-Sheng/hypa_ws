<?xml version="1.0"?>
<sdf version="1.7">
  <world name='hypa_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <solver>
          <solver_type>dantzig</solver_type>
          <!-- <solver_type>pgs</solver_type> -->
        </solver>
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system' />
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system' />
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system' />
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system' />
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system' />
    <!-- <gravity>0 0 -9.8</gravity> -->
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name='sun' type='directional'>
      <visualize>false</visualize>
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>2</intensity>
      <direction>-0.10000000000000001 -0.5 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.0099999997764825821</linear>
        <constant>0.89999997615814209</constant>
        <quadratic>0.0010000000474974513</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="rope_example">
      <static>false</static>

      <!-- Base link (fixed) -->
      <link name="start_link">
        <pose>0 0 1 0 0 0</pose>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- End link (movable via prismatic joint) -->
      <link name="end_link">
        <pose>0 0 0 0 0 0</pose>
        <visual name="end_visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="end_collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Prismatic joint to simulate rope length change -->
      <joint name="prismatic_joint" type="prismatic">
        <parent>start_link</parent>
        <child>end_link</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit>
            <lower>0</lower>
            <upper>5</upper>
            <effort>100</effort>
            <velocity>1</velocity>
          </limit>
        </axis>
      </joint>

      <!-- Rope Visualizer Plugin -->
      <plugin
        filename="libRopeVisualizer.so"
        name="hypa_gazebo::RopeVisualizer">
        <start_link>start_link</start_link>
        <end_link>end_link</end_link>
        <line_width>0.05</line_width>
        <color>
          <r>0.2</r>
          <g>0.8</g>
          <b>0.2</b>
          <a>1.0</a>
        </color>
        <show_endpoints>true</show_endpoints>
      </plugin>
    </model>
  </world>

</sdf>