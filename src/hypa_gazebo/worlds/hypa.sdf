        <pose relative_to="cable_hook_2_br">0 0 0 0 0 0</pose>
        <parent>cable_hook_2_br</parent>
        <child>cable_ring_2_br</child>
      </joint>

      <!-- 绳索关节（带力传感器） -->
      <joint name="prismatic_cable_hook_fl" type="prismatic">
        <parent>cable_hook_1_fl</parent>
        <child>cable_hook_2_fl</child>
        <pose relative_to="cable_hook_1_fl">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0.58630267844195916 0.21593098645057518 -0.78078356690075534</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>500.0</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
        <sensor name="force_torque_sensor" type="force_torque">
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <topic>joint_force_torque/prismatic_cable_hook_fl</topic>
          <force_torque>
            <frame>sensor</frame>
            <!-- <measure_direction>child_to_parent</measure_direction> -->
            <measure_direction>parent_to_child</measure_direction>
          </force_torque>
        </sensor>
      </joint>
      <joint name="prismatic_cable_hook_fr" type="prismatic">
        <parent>cable_hook_1_fr</parent>
        <child>cable_hook_2_fr</child>
        <pose relative_to="cable_hook_1_fr">0 0 0 0 0 0</pose>
        <axis>
          <xyz>0.58630267844195916 -0.21593098645057518 -0.78078356690075534</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>500.0</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
        <sensor name="force_torque_sensor" type="force_torque">
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <topic>joint_force_torque/prismatic_cable_hook_fr</topic>
          <force_torque>
            <frame>sensor</frame>
            <!-- <measure_direction>child_to_parent</measure_direction> -->
            <measure_direction>parent_to_child</measure_direction>
          </force_torque>
        </sensor>
      </joint>
      <joint name="prismatic_cable_hook_bl" type="prismatic">
        <parent>cable_hook_1_bl</parent>
        <child>cable_hook_2_bl</child>
        <pose relative_to="cable_hook_1_bl">0 0 0 0 0 0</pose>
        <axis>
          <xyz>-0.58630267844195916 0.21593098645057518 -0.78078356690075534</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>500.0</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
        <sensor name="force_torque_sensor" type="force_torque">
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <topic>joint_force_torque/prismatic_cable_hook_bl</topic>
          <force_torque>
            <frame>sensor</frame>
            <!-- <measure_direction>child_to_parent</measure_direction> -->
            <measure_direction>parent_to_child</measure_direction>
          </force_torque>
        </sensor>
      </joint>
      <joint name="prismatic_cable_hook_br" type="prismatic">
        <parent>cable_hook_1_br</parent>
        <child>cable_hook_2_br</child>
        <pose relative_to="cable_hook_1_br">0 0 0 0 0 0</pose>
        <axis>
          <xyz>-0.58630267844195916 -0.21593098645057518 -0.78078356690075534</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>500.0</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
        <sensor name="force_torque_sensor" type="force_torque">
          <update_rate>100</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <topic>joint_force_torque/prismatic_cable_hook_br</topic>
