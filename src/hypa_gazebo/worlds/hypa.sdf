            <frame>sensor</frame>
            <!-- <measure_direction>child_to_parent</measure_direction> -->
            <measure_direction>parent_to_child</measure_direction>
          </force_torque>
        </sensor>
      </joint>

      <!-- 与其他模型连接detachable -->
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>cable_ring_2_fl</parent_link>
        <child_model>slide_main_link</child_model>
        <child_link>main_link_hook_fl</child_link>
        <detach_topic>/hypa/fl/detach</detach_topic>
        <attach_topic>/hypa/fl/attach</attach_topic>
        <output_topic>/hypa/fl/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>cable_ring_2_fr</parent_link>
        <child_model>slide_main_link</child_model>
        <child_link>main_link_hook_fr</child_link>
        <detach_topic>/hypa/fr/detach</detach_topic>
        <attach_topic>/hypa/fr/attach</attach_topic>
        <output_topic>/hypa/fr/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>cable_ring_2_bl</parent_link>
        <child_model>slide_main_link</child_model>
        <child_link>main_link_hook_bl</child_link>
        <detach_topic>/hypa/bl/detach</detach_topic>
        <attach_topic>/hypa/bl/attach</attach_topic>
        <output_topic>/hypa/bl/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
