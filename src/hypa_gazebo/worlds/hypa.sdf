    <!-- 四绳索被吊装系统（下部分） -->
    <model name="slide_main_link" canonical_link="main_link">
      <pose relative_to="hypa">0 0 0 0 0 0</pose>
      <link name='main_link'>
        <pose>0 0 -4.2000000000000002 0 0 0</pose>
        <inertial>
          <pose>1.5384e-06 -7.9647000000000002e-06 -0.081466999999999998 0 0 0</pose>
          <mass>2317.0999999999999</mass>
          <inertia>
            <ixx>2152</ixx>
            <ixy>-0.00081994999999999995</ixy>
            <ixz>-0.00016841</ixz>
            <iyy>11953</iyy>
            <iyz>0.0011132</iyz>
            <izz>13870</izz>
          </inertia>
        </inertial>
        <collision name='main_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/main_link.glb</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='main_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/main_link.glb</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <joint name='secondary_link_joint' type='prismatic'>
        <pose>0 0 0 0 0 0</pose>
        <parent>main_link</parent>
        <child>secondary_link</child>
        <axis>
          <xyz>-1 0 0</xyz>
          <limit>
            <lower>-0.8</lower>
            <upper>0.8</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
            <stiffness>100000000</stiffness>
            <dissipation>1</dissipation>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
            <damping>0</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <link name='secondary_link'>
        <pose>0 0 -4.9202000000000004 0 0 0</pose>
        <inertial>
          <pose>9.2714999999999996e-05 4.4502999999999997e-05 -0.0068453000000000003 0 0 0</pose>
          <mass>926.79999999999995</mass>
          <inertia>
            <ixx>912.74000000000001</ixx>
            <ixy>6.0282999999999998e-08</ixy>
            <ixz>3.2016000000000002e-13</ixz>
            <iyy>12.877000000000001</iyy>
            <iyz>-6.4401999999999996e-11</iyz>
            <izz>907.59000000000003</izz>
          </inertia>
        </inertial>
        <collision name='secondary_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/secondary_link.glb</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='secondary_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/secondary_link.glb</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0 0 0 1</diffuse>
            <ambient>0 0 0 1</ambient>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <joint name='slide_link_joint' type='prismatic'>
        <pose>0 0 0 0 0 0</pose>
        <parent>secondary_link</parent>
        <child>slide_link</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit>
            <lower>-0.8</lower>
            <upper>0.8</upper>
            <effort>1000000</effort>
            <velocity>0.5</velocity>
            <stiffness>100000000</stiffness>
            <dissipation>1</dissipation>
          </limit>
          <dynamics>
            <spring_reference>0</spring_reference>
            <spring_stiffness>0</spring_stiffness>
            <damping>0</damping>
            <friction>0</friction>
          </dynamics>
        </axis>
      </joint>
      <link name='slide_link'>
        <pose>0 0 -8.6999999999999993 0 0 0</pose>
        <inertial>
          <pose>0.021957000000000001 0.010531 1.5253000000000001 0 0 0</pose>
          <mass>3453</mass>
          <!-- <mass>34539</mass> -->
          <inertia>
            <ixx>83582</ixx>
            <ixy>490.33999999999997</ixy>
            <ixz>1014.2</ixz>
            <iyy>174690</iyy>
            <iyz>163.74000000000001</iyz>
            <izz>189290</izz>
          </inertia>
        </inertial>
        <collision name='slide_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/slide_link.glb</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='slide_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/slide_link.glb</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.941174984 0.941174984 0.941174984 1</diffuse>
            <ambient>0.941174984 0.941174984 0.941174984 1</ambient>
          </material>
        </visual>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <static>false</static>
      <self_collide>false</self_collide>
      <!-- 四个连接点 -->
      <link name="main_link_hook_fl">
        <pose relative_to="main_link">2.93256 1.07359 0.3 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="main_link_hook_fl_visual">
          <pose>0 0 0 0 0 0</pose>
