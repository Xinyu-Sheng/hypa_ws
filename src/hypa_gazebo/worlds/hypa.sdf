      <!-- 连接点到集装箱的固定关节 -->
      <joint name="ball_cable_hook_2_fl" type="ball">
        <pose relative_to="cable_hook_2_fl">0 0 0 0 0 0</pose>
        <parent>cable_hook_2_fl</parent>
        <child>cable_ring_2_fl</child>
      </joint>
      <joint name="ball_cable_hook_2_fr" type="ball">
        <pose relative_to="cable_hook_2_fr">0 0 0 0 0 0</pose>
