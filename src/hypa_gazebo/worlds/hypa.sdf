<sdf version='1.10'>
  <world name='hypa_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <solver>
          <solver_type>dantzig</solver_type>
          <!-- <solver_type>pgs</solver_type> -->
        </solver>
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system' />
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system' />
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system' />
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system' />
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system' />
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque" />
    <!-- <gravity>0 0 -9.81</gravity> -->
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name='sun' type='directional'>
      <visualize>false</visualize>
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>2</intensity>
      <direction>-0.10000000000000001 -0.5 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.0099999997764825821</linear>
        <constant>0.89999997615814209</constant>
        <quadratic>0.0010000000474974513</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="crane">
      <pose>0 0 30 0 0 0</pose>
      <link name="crane_hook_base">
        <pose>0 0 0 0 0 0</pose>
        <visual name="crane_hook_base_visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0</mass>
        </inertial>
      </link>
      <link name="crane_hook" canonical_link="crane_hook_base">
        <pose>0 0 0 0 0 0</pose>
        <visual name="crane_hook_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>0</mass>
        </inertial>
      </link>
      <joint name="foundation" type="fixed">
        <parent>world</parent>
        <child>crane_hook_base</child>
      </joint>
      <joint name="ball_crane_hook" type="ball">
        <pose>0 0 0 0 0 0</pose>
        <parent>crane_hook_base</parent>
        <child>crane_hook</child>
        <physics>
          <damping>1</damping> <!-- 设置阻尼系数，值可以根据需求调整 -->
        </physics>
      </joint>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>crane_hook</parent_link>
        <child_model>hypa</child_model>
        <child_link>upper_hook</child_link>
        <detach_topic>/crane/detach</detach_topic>
        <attach_topic>/crane/attach</attach_topic>
        <output_topic>/crane/state</output_topic>
      </plugin>
    </model>

    <!-- 四绳索吊装系统（上部分） -->
    <model name="hypa" placement_frame="upper_hook" canonical_link="base_link">
      <pose relative_to="crane::crane_hook">0 0 0 0 0 0</pose>
      <link name="upper_hook">
        <pose>0 0 0.1 0 0 0</pose>
      </link>
      <link name='base_link'>
        <inertial>
          <pose>-1.2070000000000001e-09 3.1784000000000001e-09 -0.085376999999999995 0 0 0</pose>
          <mass>386.11000000000001</mass>
          <inertia>
            <ixx>9.9128000000000007</ixx>
            <ixy>0.13247999999999999</ixy>
            <ixz>-9.8620999999999994e-08</ixz>
            <iyy>9.8810000000000002</iyy>
            <iyz>-1.8585000000000001e-07</iyz>
            <izz>18.221</izz>
          </inertia>
        </inertial>
        <collision name='base_link_collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/base_link.glb</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name='base_link_visual'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>
                model://hypa_description/models/hypa/meshes/glb/base_link.glb</uri>
            </mesh>
          </geometry>
          <material>
            <diffuse>0.941174984 0.941174984 0.941174984 1</diffuse>
            <ambient>0.941174984 0.941174984 0.941174984 1</ambient>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <enable_wind>false</enable_wind>
      </link>
      <joint name="upper_hook_base_link_attachment" type="fixed">
        <parent>upper_hook</parent>
        <child>base_link</child>
      </joint>

      <!-- 四个虚拟连接点（用于绳索上端关节） -->
      <link name="cable_hook_1_fl">
        <pose relative_to="base_link">0.1 0.1 -0.3600 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
