              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>1 1 0 1</specular>
          </material>
        </visual>
      </link>

      <joint name="prismatic_lifting_hook_fl" type="prismatic">
        <parent>lifting_hook_1_fl</parent>
        <child>lifting_hook_2_fl</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>3.0 1.2 -10</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>50.0</upper>
            <effort>50000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
      </joint>
      <joint name="prismatic_lifting_hook_fr" type="prismatic">
        <parent>lifting_hook_1_fr</parent>
        <child>lifting_hook_2_fr</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>3.0 -1.2 -10</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>50.0</upper>
            <effort>50000</effort>
            <velocity>0.5</velocity>
