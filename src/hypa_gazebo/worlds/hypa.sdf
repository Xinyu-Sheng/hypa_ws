          <r>0.2</r>
          <g>0.8</g>
          <b>0.2</b>
          <a>1.0</a>
        </color>
        <show_endpoints>true</show_endpoints>
        <update_interval>5</update_interval>
      </plugin>
      <plugin
        filename="libRopeVisualizer.so"
        name="hypa_gazebo::RopeVisualizer">
