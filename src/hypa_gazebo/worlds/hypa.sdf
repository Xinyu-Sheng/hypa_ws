<sdf version='1.10'>
  <world name='hypa_world'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart>
        <solver>
          <solver_type>dantzig</solver_type>
          <!-- <solver_type>pgs</solver_type> -->
        </solver>
        <collision_detector>ode</collision_detector>
      </dart>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system' />
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system' />
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system' />
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system' />
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system' />
    <!-- <gravity>0 0 -9.8</gravity> -->
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic' />
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name='sun' type='directional'>
      <visualize>false</visualize>
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>2</intensity>
      <direction>-0.10000000000000001 -0.5 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.0099999997764825821</linear>
        <constant>0.89999997615814209</constant>
        <quadratic>0.0010000000474974513</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>100 100 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="crane">
      <pose>0 0 0 0 0 0</pose>
      <link name="crane_hook">
        <pose>0 0 30 0 0 0</pose>
        <visual name="crane_hook_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <!-- <mass>0.01</mass> -->
          <mass>10000</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="foundation" type="fixed">
        <parent>world</parent>
        <child>crane_hook</child>
      </joint>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>crane_hook</parent_link>
        <child_model>hypa</child_model>
        <child_link>hypa_base</child_link>
        <detach_topic>/crane/detach</detach_topic>
        <attach_topic>/crane/attach</attach_topic>
        <output_topic>/crane/state</output_topic>
      </plugin>
    </model>

    <!-- 四绳索吊装系统 -->
    <model name="hypa">
      <pose relative_to="crane::crane_hook">0 0 0 0 0 0</pose>
      <link name="hypa_base">
        <pose>0 0 0 0 0 0</pose>
      </link>
      <!-- 四个吊点初始位置的中央位置 -->
      <link name="init_container_top_center">
        <!-- 初始化时往下的位置 -->
        <pose>0 0 -10 0 0 0</pose>
        <inertial>
          <mass>1000</mass>
          <inertia>
            <ixx>500</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>800</iyy>
            <iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
        </inertial>
        <visual name="init_container_top_center_visual">
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.4 1</ambient>
            <diffuse>0.2 0.2 0.4 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <joint name="dummy_joint_for_initial_container_top_center" type="fixed">
        <parent>world</parent>
        <child>init_container_top_center</child>
      </joint>

      <!-- 四个虚拟连接点（用于绳索关节） -->
      <link name="lifting_hook_1_fl">
        <pose relative_to="ball_lifting_hook_1_fl">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0 -3.022164 0.289495 -2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 -3.022164 0.289495 -2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
      </link>

      <link name="lifting_hook_1_fr">
        <pose relative_to="ball_lifting_hook_1_fr">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0 3.022164 0.289495 2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 3.022164 0.289495 2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
      </link>

      <link name="lifting_hook_1_bl">
        <pose relative_to="ball_lifting_hook_1_bl">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0 -3.022164 -0.289495 2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 -3.022164 -0.289495 2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
      </link>

      <link name="lifting_hook_1_br">
        <pose relative_to="ball_lifting_hook_1_br">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 0 3.022164 -0.289495 -2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 3.022164 -0.289495 -2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0.5 0 1</ambient>
            <diffuse>1 0.5 0 1</diffuse>
            <specular>1 0.5 0 1</specular>
          </material>
        </visual>
      </link>
      <!-- 连接点到集装箱的固定关节 -->
      <joint name="ball_lifting_hook_1_fl" type="ball">
        <!-- 防止四个球型关节都在同一位置导致可旋转 -->
        <pose relative_to="hypa_base">0.1 0.1 0 0 0 0</pose>
        <parent>hypa_base</parent>
        <child>lifting_hook_1_fl</child>
      </joint>

      <joint name="ball_lifting_hook_1_fr" type="ball">
        <pose relative_to="hypa_base">0.1 -0.1 0 0 0 0</pose>
        <parent>hypa_base</parent>
        <child>lifting_hook_1_fr</child>
      </joint>

      <joint name="ball_lifting_hook_1_bl" type="ball">
        <pose relative_to="hypa_base">-0.1 0.1 0 0 0 0</pose>
        <parent>hypa_base</parent>
        <child>lifting_hook_1_bl</child>
      </joint>

      <joint name="ball_lifting_hook_1_br" type="ball">
        <pose relative_to="hypa_base">-0.1 -0.1 0 0 0 0</pose>
        <parent>hypa_base</parent>
        <child>lifting_hook_1_br</child>
      </joint>
      <!-- 四个虚拟连接点（用于绳索关节） -->
      <link name="lifting_hook_2_fl">
        <pose relative_to="init_container_top_center">3.0 1.2 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <pose>0 0 0 -3.022164 0.289495 -2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 -3.022164 0.289495 -2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>1 0 0 1</specular>
          </material>
        </visual>
      </link>

      <link name="lifting_hook_2_fr">
        <pose relative_to="init_container_top_center">3.0 -1.2 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <pose>0 0 0 3.022164 0.289495 2.363151</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>1 1 0 1</specular>
          </material>
        </visual>
        <visual name="visual">
          <pose>0 0 0 3.022164 0.289495 2.363151</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>1 1 0 1</specular>
          </material>
        </visual>
      </link>

      <link name="lifting_hook_2_bl">
        <pose relative_to="init_container_top_center">-3.0 1.2 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="prismatic_marker">
          <pose>0 0 0 -3.022164 -0.289495 2.363151</pose>
          <geometry>
