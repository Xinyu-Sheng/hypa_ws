            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- 连接四个点的固定关节 -->
      <joint name="fixed_main_link_hook_fl" type="fixed">
        <parent>main_link</parent>
        <child>main_link_hook_fl</child>
      </joint>
      <joint name="fixed_main_link_hook_fr" type="fixed">
        <parent>main_link</parent>
        <child>main_link_hook_fr</child>
      </joint>
      <joint name="fixed_main_link_hook_bl" type="fixed">
        <parent>main_link</parent>
        <child>main_link_hook_bl</child>
      </joint>
      <joint name="fixed_main_link_hook_br" type="fixed">
        <parent>main_link</parent>
        <child>main_link_hook_br</child>
      </joint>


      <!-- 关节状态与控制插件 -->
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>secondary_link_joint</joint_name>
        <joint_name>slide_link_joint</joint_name>
      </plugin>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>secondary_link_joint</joint_name>
        <p_gain>10000000</p_gain> <!-- 极高的 P 增益 -->
        <i_gain>1.0</i_gain>
        <d_gain>500000</d_gain>
        <cmd_min>-1000000</cmd_min> <!-- 这里的范围要与 effort 对应 -->
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
      </plugin>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>slide_link_joint</joint_name>
        <p_gain>10000000</p_gain> <!-- 极高的 P 增益 -->
        <i_gain>1.0</i_gain>
        <d_gain>500000</d_gain>
