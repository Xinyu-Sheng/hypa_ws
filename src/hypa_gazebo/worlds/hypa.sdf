      <joint name="ball_lifting_hook_2_br" type="ball">
        <pose relative_to="lifting_hook_2_br">0 0 0 0 0 0</pose>
        <parent>lifting_hook_2_br</parent>
        <child>lifting_ring_2_br</child>
      </joint>


      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_lifting_hook_fl</joint_name>
        <p_gain>5000000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>100000</d_gain>
        <cmd_min>-1000000</cmd_min>
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
        <!-- use_velocity_commands 控制模式：
        Topic 发送：始终是 position（位置）
        内部处理：
        false：position → PID → force（力矩控制）
        true：position → 绕过PID → velocity（直接速度控制）
        cmd_min和cmd_max标签就针对的是两种底层cmd的限制 -->
      </plugin>

      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_lifting_hook_fr</joint_name>
        <p_gain>5000000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>100000</d_gain>
        <cmd_min>-1000000</cmd_min>
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
      </plugin>

      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_lifting_hook_bl</joint_name>
        <p_gain>5000000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>100000</d_gain>
        <cmd_min>-1000000</cmd_min>
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
      </plugin>

      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_lifting_hook_br</joint_name>
        <p_gain>5000000</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>100000</d_gain>
        <cmd_min>-1000000</cmd_min>
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
      </plugin>

      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>lifting_ring_2_fl</parent_link>
        <child_model>container</child_model>
        <child_link>container_hook_fl</child_link>
        <detach_topic>/hypa/fl/detach</detach_topic>
        <attach_topic>/hypa/fl/attach</attach_topic>
        <output_topic>/hypa/fl/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>lifting_ring_2_fr</parent_link>
        <child_model>container</child_model>
        <child_link>container_hook_fr</child_link>
        <detach_topic>/hypa/fr/detach</detach_topic>
        <attach_topic>/hypa/fr/attach</attach_topic>
        <output_topic>/hypa/fr/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>lifting_ring_2_bl</parent_link>
        <child_model>container</child_model>
        <child_link>container_hook_bl</child_link>
        <detach_topic>/hypa/bl/detach</detach_topic>
        <attach_topic>/hypa/bl/attach</attach_topic>
        <output_topic>/hypa/bl/state</output_topic>
      </plugin>
      <plugin
        filename="gz-sim-detachable-joint-system"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>lifting_ring_2_br</parent_link>
        <child_model>container</child_model>
        <child_link>container_hook_br</child_link>
        <detach_topic>/hypa/br/detach</detach_topic>
        <attach_topic>/hypa/br/attach</attach_topic>
        <output_topic>/hypa/br/state</output_topic>
      </plugin>
    </model>

    <!-- 集装箱模型 -->
    <model name="container">
      <pose relative_to="hypa::init_container_top_center">0 0 -2.5 0 0 0</pose>
      <!-- 集装箱主体 -->
      <link name="container_base">
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <mass>2000</mass> <!-- 2吨集装箱 -->
          <inertia>
            <ixx>500</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>800</iyy>
            <iyz>0</iyz>
            <izz>1000</izz>
          </inertia>
          <pose>0 0 1.25 0 0 0</pose>
        </inertial>

        <!-- 集装箱主体 -->
        <collision name="container_collision">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>6.0 2.4 2.5</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="container_visual">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>6.0 2.4 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.8 1</ambient>
            <diffuse>0.2 0.2 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

      </link>

      <!-- 四个虚拟连接点 -->
      <link name="container_hook_fl">
        <pose>3.0 1.2 2.5 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="container_hook_fl_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="container_hook_fr">
        <pose>3.0 -1.2 2.5 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="container_hook_fr_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="container_hook_bl">
        <pose>-3.0 1.2 2.5 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="container_hook_bl_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="container_hook_br">
        <pose>-3.0 -1.2 2.5 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="container_hook_br_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.1</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
          </material>
        </visual>
      </link>


      <!-- 连接点到集装箱的固定关节 -->
      <joint name="fixed_container_hook_fl" type="fixed">
        <parent>container_base</parent>
        <child>container_hook_fl</child>
      </joint>

      <joint name="fixed_container_hook_fr" type="fixed">
        <parent>container_base</parent>
        <child>container_hook_fr</child>
      </joint>

      <joint name="fixed_container_hook_bl" type="fixed">
        <parent>container_base</parent>
        <child>container_hook_bl</child>
      </joint>

      <joint name="fixed_container_hook_br" type="fixed">
        <parent>container_base</parent>
        <child>container_hook_br</child>
      </joint>

    </model>
  </world>
</sdf>