        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>


      <!-- 连接点到集装箱的固定关节 -->
      <joint name="ball_lifting_hook_2_fl" type="ball">
        <pose relative_to="lifting_hook_2_fl">0 0 0 0 0 0</pose>
        <parent>lifting_hook_2_fl</parent>
        <child>lifting_ring_2_fl</child>
      </joint>

      <joint name="ball_lifting_hook_2_fr" type="ball">
        <pose relative_to="lifting_hook_2_fr">0 0 0 0 0 0</pose>
        <parent>lifting_hook_2_fr</parent>
        <child>lifting_ring_2_fr</child>
      </joint>

      <joint name="ball_lifting_hook_2_bl" type="ball">
        <pose relative_to="lifting_hook_2_bl">0 0 0 0 0 0</pose>
        <parent>lifting_hook_2_bl</parent>
