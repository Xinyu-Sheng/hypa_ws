      <!-- gui与仿真可视化插件 -->
      <plugin
        filename="libRopeVisualizer.so"
        name="hypa_gazebo::RopeVisualizer">
        <start_link>cable_hook_1_fl</start_link>
        <end_link>cable_hook_2_fl</end_link>
