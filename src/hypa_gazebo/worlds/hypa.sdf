      <joint name="prismatic_lifting_hook_br" type="prismatic">
        <parent>lifting_hook_1_br</parent>
        <child>lifting_hook_2_br</child>
        <pose>0 0 0 0 0 0</pose>
        <axis>
          <xyz>-3.0 -1.2 -10</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>50.0</upper>
            <effort>50000</effort>
            <velocity>0.5</velocity>
          </limit>
        </axis>
      </joint>

      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <!-- 发布所有关节状态 -->
      </plugin>


      <link name="lifting_ring_2_fl">
        <pose relative_to="lifting_hook_2_fl">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>

      <link name="lifting_ring_2_fr">
        <pose relative_to="lifting_hook_2_fr">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
