      <!-- 关节状态与控制插件 -->
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>prismatic_cable_hook_fl</joint_name>
        <joint_name>prismatic_cable_hook_fr</joint_name>
        <joint_name>prismatic_cable_hook_bl</joint_name>
        <joint_name>prismatic_cable_hook_br</joint_name>
      </plugin>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_cable_hook_fl</joint_name>
        <p_gain>10000000</p_gain> <!-- 极高的 P 增益 -->
        <i_gain>1.0</i_gain>
        <d_gain>500000</d_gain>
        <cmd_min>-1000000</cmd_min> <!-- 这里的范围要与 effort 对应 -->
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
      </plugin>
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>prismatic_cable_hook_fr</joint_name>
        <p_gain>10000000</p_gain> <!-- 极高的 P 增益 -->
        <i_gain>1.0</i_gain>
        <d_gain>500000</d_gain>
        <cmd_min>-1000000</cmd_min> <!-- 这里的范围要与 effort 对应 -->
        <cmd_max>1000000</cmd_max>
        <initial_position>0</initial_position>
        <use_velocity_commands>false</use_velocity_commands>
